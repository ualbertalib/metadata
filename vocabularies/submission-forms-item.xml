        <!-- Form which defines the second page/section of the "traditional" DSpace submission process,
             often used when depositing normal Items. -->
        <form name="traditionalpagetwo">
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>contributor</dc-element>
                    <dc-qualifier>other</dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Additional contributors</label>
                    <input-type>onebox</input-type>
                    <hint>Enter one or multiple contributors (a person or group you want to recognize for playing a role in the creation of this item, but not the primary role). If there is a specific role you would like noted, include it in parentheses, e.g. "Jones, Mary (Advisor)."</hint>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>coverage</dc-element>
                    <dc-qualifier>spatial</dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Is this item about a place?</label>
                    <input-type>tag</input-type>
                    <hint>Enter one or multiple places related to the item, such as the city, province, or country the item's contents are about.</hint>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>coverage</dc-element>
                    <dc-qualifier>temporal</dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Is this item about a time?</label>
                    <input-type>tag</input-type>
                    <hint>Enter one or multiple temporal references related to the item. Examples: a specific date: 2009-12-31; a date range: 2003-2010; a time period: the Enlightenment.</hint>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>relation</dc-element>
                    <dc-qualifier>isversionof</dc-qualifier>
                    <repeatable>true</repeatable>
                    <label>Citations for previous publication</label>
                    <input-type>onebox</input-type>
                    <hint>If your item has been previously published, enter one or multiple citations.</hint>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>source</dc-element>
                    <dc-qualifier></dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Source</label>
                    <input-type>onebox</input-type>
                    <hint>Brief information about an item from which this item was derived.</hint>
                </field>
            </row>
            <row>
                <field>
                    <dc-schema>dc</dc-schema>
                    <dc-element>relation</dc-element>
                    <dc-qualifier></dc-qualifier>
                    <repeatable>false</repeatable>
                    <label>Link to related item</label>
                    <input-type>onebox</input-type>
                    <hint>Must be a url. Example: &lt;http://www.ualberta.ca&gt;.</hint>
                </field>
            </row>
            <!--<row>
                <field>
                    <dc-schema>dc</dc-schema>
